# OpenAQ API v3 Configuration
# Lấy API key miễn phí tại: https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here

# Trạm tham chiếu: Số 1 đường Giải Phóng - phường Bạch Mai - ĐHBK (OpenAQ Location ID: 4946813)
OPENAQ_LOCATION_ID=4946813

# Tọa độ trạm ĐHBK / Hà Nội (dùng cho đồng bộ khí tượng T, RH, Pressure khi warm-start)
STATION_LAT=21.0056
STATION_LON=105.8433

# Cấu hình Backend Server (khớp với proxy /api trong frontend/vite.config.js)
PORT=5000
HOST=0.0.0.0
DB_PATH=results/realtime_aqi.db

